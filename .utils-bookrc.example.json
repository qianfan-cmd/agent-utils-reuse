{
  "projectRoot": ".",
  "utilsDir": "src/utils",
  "catalogDir": "docs/agent-catalog",
  "utilsBookDir": "docs/agent-catalog/utils-book",
  "utilsIndexFile": "docs/agent-catalog/utils-index.json",
  "skillsDir": ".cursor/skills",
  "agentsFile": "AGENTS.md",
  "jsdocTag": "@utils-book",
  "hookMode": "off",
  "sameTurnAllow": true,
  "maxImportSymbolsPerTurn": 5,
  "agentsReadMode": "tool",
  "lightGatePaths": [],
  "searchSynonyms": {
    "mention": ["mention", "prompt", "纯文本"],
    "timeout": ["timeout", "Promise", "slow"]
  },
  "crossFileSiblingGroups": [
    ["blobToBase64", "fileToBase64"],
    ["uploadFiles", "uploadMultipleFiles", "uploadSingleFile"],
    ["downloadAndUploadImage", "handleImageParam"]
  ],
  "requireDiscoveryForUtilGate": false,
  "preferCliSearch": false,
  "strictBatchLimit": false,
  "allowBusinessDiscovery": true,
  "utilsImportAliases": ["@/utils"],
  "remindWritePaths": ["src/feature", "src/components", "src/hooks", "src/views"],
  "sourceGlobs": ["src/**/*.{vue,ts,tsx}"],
  "projectAgentCoreRule": null
}
