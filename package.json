{
  "name": "agent-utils-reuse",
  "version": "0.1.9",
  "description": "Agent utils reuse gate: utils-book generator, five-question Confirm flow, Cursor templates",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qianfan-cmd/agent-utils-reuse.git"
  },
  "homepage": "https://github.com/qianfan-cmd/agent-utils-reuse#readme",
  "bugs": {
    "url": "https://github.com/qianfan-cmd/agent-utils-reuse/issues"
  },
  "bin": {
    "agent-utils-reuse": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "lib",
    "templates",
    "examples",
    ".utils-bookrc.example.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cursor",
    "agent",
    "utils",
    "reuse",
    "utils-book",
    "ai-coding"
  ],
  "scripts": {
    "test:hooks": "node scripts/test-hook-confirm.mjs",
    "test:update": "node scripts/test-update.mjs",
    "gen:utils-book": "agent-utils-reuse gen",
    "check:utils-book": "agent-utils-reuse gen && git diff --exit-code docs/agent-catalog/utils-book/"
  }
}
