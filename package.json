{
  "name": "agent-utils-reuse",
  "version": "0.3.3",
  "description": "Agent utils reuse gate: utils-index KV search, five-question Confirm flow, Cursor templates",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qianfan-cmd/agent-utils-reuse.git"
  },
  "homepage": "https://github.com/qianfan-cmd/agent-utils-reuse#readme",
  "bugs": {
    "url": "https://github.com/qianfan-cmd/agent-utils-reuse/issues"
  },
  "bin": {
    "agent-utils-reuse": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "lib",
    "templates",
    "examples",
    ".utils-bookrc.example.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cursor",
    "agent",
    "utils",
    "reuse",
    "utils-book",
    "ai-coding"
  ],
  "scripts": {
    "test:hooks": "node scripts/test-hook-confirm.mjs",
    "test:search-utils-index": "node scripts/test-search-utils-index.mjs",
    "test:hook-discovery": "node scripts/test-hook-discovery.mjs",
    "test:verdict-substance": "node scripts/test-verdict-substance.mjs",
    "test:update": "node scripts/test-update.mjs",
    "test:resolve-upgrade-spec": "node scripts/test-resolve-upgrade-spec.mjs",
    "gen:utils-book": "agent-utils-reuse gen",
    "check:utils-book": "agent-utils-reuse gen && git diff --exit-code docs/agent-catalog/utils-book/ docs/agent-catalog/utils-index.json",
    "update:utils-reuse": "agent-utils-reuse update --yes",
    "upgrade:utils-reuse": "agent-utils-reuse upgrade --yes",
    "check:version": "node scripts/check-package-version.mjs"
  }
}
